#include "resource.h"
#include <afxres.h>
#pragma code_page(65001)

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_LOCALSENSENOVA_DIALOG DIALOGEX 0, 0, 860, 560
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
CAPTION "LocalSenseNova"
FONT 10, "Segoe UI"
BEGIN
    LTEXT           "LocalSenseNova", IDC_APP_TITLE, 14, 14, 160, 22
    LTEXT           "本地 AI 对话助手", IDC_APP_SUBTITLE, 14, 38, 160, 14
    PUSHBUTTON      "＋  新建对话", IDC_BTN_NEW_SESSION, 14, 66, 172, 30
    LTEXT           "最近", IDC_SIDEBAR_SECTION, 16, 112, 120, 14
    LISTBOX         IDC_SESSION_LIST, 14, 132, 172, 342, LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | LBS_NOINTEGRALHEIGHT
    PUSHBUTTON      "删除当前对话", IDC_BTN_DELETE_SESSION, 14, 486, 172, 28

    LTEXT           "LocalSenseNova", IDC_HEADER_TITLE, 214, 17, 170, 20
    LTEXT           "未加载模型", IDC_MODEL_PATH, 214, 40, 420, 14, SS_LEFTNOWORDWRAP
    PUSHBUTTON      "加载 GGUF", IDC_BTN_LOAD_MODEL, 660, 14, 92, 28
    PUSHBUTTON      "参数", IDC_BTN_TOGGLE_SETTINGS, 760, 14, 72, 28

    CONTROL         "", IDC_CHAT, "RichEdit50W", ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, 214, 68, 618, 354
    CONTROL         "", IDC_INPUT, "Edit", ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP, 224, 438, 500, 70
    PUSHBUTTON      "发送  ↑", IDC_BTN_SEND, 738, 438, 94, 32
    PUSHBUTTON      "停止", IDC_BTN_STOP, 738, 478, 94, 30
    LTEXT           "状态：请选择并加载 GGUF 模型", IDC_STATUS, 224, 520, 608, 24, SS_LEFT

    LTEXT           "生成设置", IDC_SETTINGS_TITLE, 650, 76, 150, 20
    LTEXT           "助手预设", IDC_LABEL_PRESET, 650, 112, 80, 14
    COMBOBOX        IDC_COMBO_PRESET, 650, 130, 180, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "System Prompt", IDC_LABEL_SYSTEM, 650, 170, 110, 14
    EDITTEXT        IDC_EDIT_SYSTEM, 650, 188, 180, 106, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Temperature", IDC_LABEL_TEMP, 650, 314, 86, 14
    EDITTEXT        IDC_EDIT_TEMP, 752, 310, 78, 22, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Top-P", IDC_LABEL_TOPP, 650, 346, 86, 14
    EDITTEXT        IDC_EDIT_TOPP, 752, 342, 78, 22, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Top-K", IDC_LABEL_TOPK, 650, 378, 86, 14
    EDITTEXT        IDC_EDIT_TOPK, 752, 374, 78, 22, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Repeat Penalty", IDC_LABEL_REPEAT, 650, 410, 96, 14
    EDITTEXT        IDC_EDIT_REPEAT, 752, 406, 78, 22, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Max Tokens", IDC_LABEL_MAXTOK, 650, 442, 86, 14
    EDITTEXT        IDC_EDIT_MAXTOK, 752, 438, 78, 22, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "应用设置", IDC_BTN_APPLY_SETTINGS, 650, 480, 180, 30
END
